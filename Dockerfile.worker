# Worker image (same workspace as the gateway, different entrypoint).
# Select the queue with `-Q text|vision|audio` (see docker-compose.coolify.yml).
#
# The media pipeline runs self-contained: the optional `worker[*]` extras are installed
# here plus the system packages they need (tesseract-ocr for OCR, ffmpeg for audio,
# libsndfile1/espeak-ng data for Piper TTS, OpenGL/vips libs for Pillow + OpenCV).
FROM python:3.14-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-por \
        espeak-ng \
        espeak-ng-data \
        libsndfile1 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgomp1 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY packages ./packages
COPY apps ./apps

# `--all-extras` installs the worker[ocr|vision|audio|tts|pdf|data] extras declared in
# apps/worker/pyproject.toml so the local providers work without a remote *_URL service.
RUN uv sync --frozen --no-dev --all-packages --all-extras

ENV PATH="/app/.venv/bin:$PATH" \
    HF_HOME=/home/app/.cache/huggingface \
    TORCH_HOME=/home/app/.cache/torch \
    PIPER_VOICES_DIR=/home/app/.cache/piper \
    XDG_CACHE_HOME=/home/app/.cache

# Model caches live on a mounted volume (see docker-compose) and must be writable by
# the runtime user (containers run as root here, but keep the path stable + present).
RUN mkdir -p /home/app/.cache/huggingface /home/app/.cache/torch /home/app/.cache/piper

# Heavy queues run one job at a time; models are loaded lazily on first use.
CMD ["celery", "-A", "worker.celery_app:celery_app", "worker", "-Q", "text", "--concurrency=1", "--loglevel=INFO"]
