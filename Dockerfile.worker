# Worker image (same workspace as the gateway, different entrypoint).
# Select the queue with `-Q text|vision|audio` (see docker-compose.coolify.yml).
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY packages ./packages
COPY apps ./apps

RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# Heavy queues run one job at a time; models are loaded lazily on first use.
CMD ["celery", "-A", "worker.celery_app:celery_app", "worker", "-Q", "text", "--concurrency=1", "--loglevel=INFO"]
