# Central de login (app exclusivo de autenticação)

VITE_API_BASE=https://api.agenteresolve.com.br

# OBRIGATÓRIA aqui: sem ela o Clerk não carrega e a página explica como voltar.
# Este é o ÚNICO frontend que exige a publishable key — os serviços usam o
# token de sessão do gateway e não carregam o Clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Origens permitidas no ?redirect= (além de *.agenteresolve.com.br e localhost).
# VITE_ALLOWED_REDIRECT_ORIGINS=https://meu-dominio.com.br
