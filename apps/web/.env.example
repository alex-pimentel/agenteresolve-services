# Base URL of the AI services gateway (FastAPI).
VITE_API_BASE=https://api.agenteresolve.com.br

# Clerk publishable key. REQUIRED in production builds: the gateway rejects
# unauthenticated calls (401) and the UI prompts sign-in / shows credit errors.
# Without it the header renders a neutral fallback instead of crashing.
# NEVER put the Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=

# Standalone client-side Louder app, surfaced by the /louder route.
VITE_LOUDER_URL=https://louder.agenteresolve.com.br
