# Base URL of the AI services gateway (FastAPI).
VITE_API_BASE=https://api.agenteresolve.com.br

# Optional Clerk publishable key. Without it the header renders a neutral
# fallback instead of crashing. NEVER put the Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=

# Standalone client-side Louder app, surfaced by the /louder route.
VITE_LOUDER_URL=https://louder.agenteresolve.com.br
