# =============================================================================
# Agenteresolve AI Services platform — environment reference
# Copy to `.env` and fill in. NEVER commit real secrets.
# Every dependency is reachable by URL + key so components can be moved between
# VPS without code changes.
# =============================================================================

# --- Broker / ephemeral job state (Redis) ------------------------------------
# Required in production. Without it the gateway/worker fall back to in-memory
# stores (single-process only, fine for tests).
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=86400

# --- Cloudflare R2 (S3-compatible, private `tmp` bucket, 24h lifecycle) ------
# Without R2 credentials an in-memory store is used (dev/tests only).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tmp
R2_REGION=auto
R2_PRESIGN_SECONDS=3600

# --- Clerk auth ----------------------------------------------------------------
# AUTH_REQUIRED=true (production default): every /api/* route requires a valid
# Clerk session JWT. Set AUTH_REQUIRED=false for local dev without Clerk.
AUTH_REQUIRED=true
CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-app>.clerk.accounts.dev
CLERK_AUDIENCE=

# --- Centralized billing (Laravel is the source of truth) --------------------
# BILLING_ENABLED=true in production: the gateway reserves credits on job
# creation and settles (commit on success, refund on error). Failed calls are
# never charged. CREDITS_SERVICE_TOKEN must match the Laravel app's value.
BILLING_ENABLED=false
BILLING_BASE_URL=https://agenteresolve.com.br
CREDITS_SERVICE_TOKEN=
BILLING_TIMEOUT=10

# --- Centralized login (gateway session tokens) ------------------------------
# HMAC secret for the long-lived session tokens issued at POST /api/auth/session.
# Must be long and random; shared by all gateway replicas only (never frontend).
GATEWAY_SESSION_SECRET=
# Session lifetime in seconds (default 30 days).
GATEWAY_SESSION_TTL_SECONDS=2592000

# --- LLM (OpenAI-compatible; default provider is OpenRouter) -----------------
# If LLM_BASE_URL is omitted but LLM_API_KEY is set, OpenRouter is used.
# Point at OpenAI/Groq/Ollama as needed.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=60

# --- Embeddings (OpenAI-compatible) ------------------------------------------
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- OCR (remote endpoint; otherwise local backend required) -----------------
# Remote: if OCR_URL is set the worker POSTs {OCR_URL}/ocr with the file.
# Local: set OCR_URL empty and install the `worker[ocr]` extra (pytesseract + Pillow).
OCR_URL=
OCR_KEY=

# --- Vision (captioning/detection; remote or local) --------------------------
# Remote: {VISION_URL}/caption and {VISION_URL}/detect.
# Local: install the `worker[vision]` extra (transformers + ultralytics + Pillow + numpy).
VISION_URL=
VISION_KEY=

# --- Audio (ASR/denoise; remote or local) ------------------------------------
# Remote: {AUDIO_URL}/transcribe and {AUDIO_URL}/enhance.
# Local: install the `worker[audio]` extra (faster-whisper) and ffmpeg on PATH.
AUDIO_URL=
AUDIO_KEY=

# --- TTS (remote or local Piper) ---------------------------------------------
# Remote: {TTS_URL}/synthesize. Local: install the `worker[tts]` extra (piper-tts).
TTS_URL=
TTS_KEY=

# --- Optional local document/data/model extras -------------------------------
# Document text extraction (docuextract/contracts) and DataChat pandas sandbox are
# optional; without them those tools fall back to OCR or report provider_unavailable.
# Install everything with: uv sync --all-extras --all-packages
#   worker[pdf]     -> pypdf + python-docx
#   worker[data]    -> pandas + openpyxl
#   worker[vision]  -> Pillow + numpy (pixel redaction / NMS)
#   worker[ocr]     -> pytesseract
#   worker[audio]   -> faster-whisper
#   worker[tts]     -> piper-tts
#   worker[vision]  -> transformers + ultralytics (BLIP/YOLO)

# --- Media (YouTube -> MP3; heavy yt-dlp + ffmpeg on Oracle) ------------------
# Remote: {MEDIA_URL}/youtube-mp3 with {"url", "quality"}. The Oracle host
# (tailnet, e.g. http://100.92.240.55:8000) owns yt-dlp + ffmpeg; Coolify
# workers stay light. Empty = local yt-dlp + ffmpeg fallback (dev only).
MEDIA_URL=
MEDIA_KEY=
MEDIA_TIMEOUT=300

# --- Outbound fetch guard (SEO URL import) -----------------------------------
# SEO blocks private/loopback/link-local/reserved addresses (SSRF). Timeout in seconds.
FETCH_TIMEOUT=10
SSRF_BLOCK_PRIVATE=true

# --- Worker container (used by docker-compose / Coolify) ---------------------
# Heavy queues (vision/audio) run with concurrency=1. See docker-compose.coolify.yml.
WORKER_QUEUES=text
WORKER_CONCURRENCY=1
