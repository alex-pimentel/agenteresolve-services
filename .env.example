# =============================================================================
# Agenteresolve AI Services platform — environment reference
# Copy to `.env` and fill in. NEVER commit real secrets.
# Every dependency is reachable by URL + key so components can be moved between
# VPS without code changes.
# =============================================================================

# --- Broker / ephemeral job state (Redis) ------------------------------------
# Required in production. Without it the gateway/worker fall back to in-memory
# stores (single-process only, fine for tests).
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=86400

# --- Cloudflare R2 (S3-compatible, private `tmp` bucket, 24h lifecycle) ------
# Without R2 credentials an in-memory store is used (dev/tests only).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tmp
R2_REGION=auto
R2_PRESIGN_SECONDS=3600

# --- Clerk auth (optional; anonymous allowed when unset) ---------------------
CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-app>.clerk.accounts.dev
CLERK_AUDIENCE=

# --- LLM (OpenAI-compatible; default provider is OpenRouter) -----------------
# If LLM_BASE_URL is omitted but LLM_API_KEY is set, OpenRouter is used.
# Point at OpenAI/Groq/Ollama as needed.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=60

# --- Embeddings (OpenAI-compatible) ------------------------------------------
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- OCR (remote endpoint; otherwise local backend required) -----------------
OCR_URL=
OCR_KEY=

# --- Vision (captioning/detection; remote or local) --------------------------
VISION_URL=
VISION_KEY=

# --- Audio (ASR/denoise; remote or local) ------------------------------------
AUDIO_URL=
AUDIO_KEY=

# --- TTS (remote or local Piper) ---------------------------------------------
TTS_URL=
TTS_KEY=

# --- Worker container (used by docker-compose / Coolify) ---------------------
# Heavy queues (vision/audio) run with concurrency=1. See docker-compose.coolify.yml.
WORKER_QUEUES=text
WORKER_CONCURRENCY=1
